# JobNavigator-IT environment template
# Copy this file to .env and fill real secrets locally. Do not commit .env.
# All runtime variables use the JOBNAV_ prefix.

# ---- LLM config for Agent and report generation ----
# The backend calls an OpenAI-compatible /chat/completions endpoint.
# Alibaba Cloud DashScope / Bailian compatible-mode example:
#   JOBNAV_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   JOBNAV_LLM_MODEL=qwen-plus
# You can switch the model to qwen-turbo, qwen-max, or another enabled model.
JOBNAV_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JOBNAV_LLM_API_KEY=
JOBNAV_LLM_MODEL=qwen-plus
JOBNAV_LLM_TIMEOUT_SEC=60

# ---- Optional data stores ----
# JOBNAV_POSTGRES_DSN=postgresql://jobnav:jobnav@localhost:5432/jobnavigator
# JOBNAV_REDIS_URL=redis://localhost:6379/0

# ---- App ----
JOBNAV_APP_ENV=dev

# ---- Trend module ----
JOBNAV_TREND_HORIZON_MONTHS=3
JOBNAV_TREND_EXPORT_DIR=data/gold
JOBNAV_TREND_HF_RECRUITMENT_DATASET=lang-uk/recruitment-dataset-job-descriptions-english
JOBNAV_TREND_HF_LOCAL_ARROW_PATH=data/raw/recruitment-dataset-job-descriptions-english-train.arrow
JOBNAV_TREND_HF_LOCAL_CSV_PATH=data/raw/recruitment-dataset-job-descriptions-english-train.csv
JOBNAV_TREND_HF_LOCAL_INFO_PATH=data/raw/dataset_info.json
JOBNAV_TREND_HF_SAMPLE_LIMIT=2000
JOBNAV_TREND_JD_MIN_DATE=2022-01-01
JOBNAV_TREND_ENABLE_HF_RECRUITMENT=true
JOBNAV_TREND_ENABLE_KAGGLE_LINKEDIN=false
JOBNAV_TREND_KAGGLE_DATA_DIR=data/raw
JOBNAV_TREND_KAGGLE_SAMPLE_LIMIT=3000
JOBNAV_TREND_ENABLE_LINKEDIN_POSTINGS=true
JOBNAV_TREND_LINKEDIN_POSTINGS_PATH=data/raw/linkedin_job_postings.csv
JOBNAV_TREND_LINKEDIN_SKILLS_PATH=data/raw/job_skills.csv
JOBNAV_TREND_LINKEDIN_CHUNK_SIZE=50000
JOBNAV_TREND_LINKEDIN_SAMPLE_LIMIT=0
JOBNAV_TREND_ENABLE_AI_JOB_DATASET=true
JOBNAV_TREND_AI_JOB_DATASET_PATH=data/raw/ai_job_dataset1.csv
JOBNAV_TREND_AI_JOB_SAMPLE_LIMIT=0
JOBNAV_TREND_STANDARDIZE_MAX_ROWS=5000
JOBNAV_TREND_ENABLE_GDELT=true
JOBNAV_TREND_GDELT_ROLE_LIMIT=10
JOBNAV_TREND_GDELT_MAX_RECORDS=30
JOBNAV_TREND_GDELT_SLEEP_SEC=0.2
JOBNAV_TREND_GDELT_BIGQUERY_ENABLED=true
JOBNAV_TREND_GDELT_BIGQUERY_PROJECT=jobnavigator-it-bigquery
JOBNAV_TREND_GDELT_BIGQUERY_CREDENTIALS_PATH=secrets/service-account-key.json
JOBNAV_TREND_GDELT_BIGQUERY_MONTHS=6
JOBNAV_TREND_GDELT_BIGQUERY_ROLE_LIMIT=10
JOBNAV_TREND_GDELT_BIGQUERY_TOP_SKILLS=10
JOBNAV_TREND_GDELT_BIGQUERY_MAX_DOCS_PER_ROLE=500
JOBNAV_TREND_GDELT_BIGQUERY_EVENTS_ENABLED=false
JOBNAV_TREND_GDELT_LOCAL_DIR=data/GDELT
JOBNAV_TREND_GDELT_LOCAL_BATCH_SIZE=10
JOBNAV_TREND_GDELT_RAW_EXPORT_LIMIT=20000
JOBNAV_TREND_GDELT_LOCAL_PROCESSED_DIR=data/gold/gdelt_gkg_processed
JOBNAV_TREND_ENABLE_GOOGLE_TRENDS=false
JOBNAV_TREND_ENABLE_GITHUB=true
JOBNAV_TREND_ENABLE_ARXIV=true
JOBNAV_TREND_GITHUB_TOKEN=
JOBNAV_TREND_GOOGLE_TRENDS_GEO=
JOBNAV_TREND_TECH_ROLE_LIMIT=0
JOBNAV_TREND_TECH_SKILL_LIMIT=20
JOBNAV_TREND_GITHUB_MONTHS=6
JOBNAV_TREND_GITHUB_TOP_ITEMS=5
JOBNAV_TREND_ARXIV_MONTHS=6
JOBNAV_TREND_ARXIV_MAX_RESULTS=50
JOBNAV_TREND_PATCHTST_LOOKBACK_MONTHS=24
