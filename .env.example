# JobNavigator-IT 环境配置模板
# 复制为 .env 并填入真实值（.env 不会提交到 git）
# 变量前缀: JOBNAV_

# ---- LLM 大模型配置（必填）----
JOBNAV_LLM_BASE_URL=https://api.openai.com/v1
JOBNAV_LLM_API_KEY=
JOBNAV_LLM_MODEL=
JOBNAV_LLM_TIMEOUT_SEC=60

# ---- 数据库（可选，有默认值）----
# JOBNAV_POSTGRES_DSN=postgresql://jobnav:jobnav@localhost:5432/jobnavigator
# JOBNAV_REDIS_URL=redis://localhost:6379/0

# ---- 应用 ----
JOBNAV_APP_ENV=dev
