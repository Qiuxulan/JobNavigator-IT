# JobNavigator-IT environment template
# Copy this file to .env and fill real secrets locally. Do not commit .env.
# All runtime variables use the JOBNAV_ prefix.

# ---- LLM config（精排 / Agent / 报告生成，OpenAI 兼容协议）----
# DeepSeek 示例：
#   JOBNAV_LLM_BASE_URL=https://api.deepseek.com/v1
#   JOBNAV_LLM_MODEL=deepseek-chat
JOBNAV_LLM_BASE_URL=https://api.deepseek.com/v1
JOBNAV_LLM_API_KEY=
JOBNAV_LLM_MODEL=deepseek-chat
JOBNAV_LLM_TIMEOUT_SEC=60
JOBNAV_LLM_RERANK_TIMEOUT_SEC=30

# ---- 数据存储 ----
JOBNAV_POSTGRES_DSN=postgresql://jobnav:jobnav@localhost:5432/jobnavigator
# JOBNAV_REDIS_URL=redis://localhost:6379/0

# ---- App ----
JOBNAV_APP_ENV=dev

# ---- 主链路开关与数据路径（默认值即当前生产配置，一般无需修改）----
# 学习路径规划器版本：必须 v4（缺省会回退旧版 v3）
JOBNAV_PATH_PLANNER=v4
# 岗位画像 / 匹配分数校准参数 / 技能趋势面板 / 技能先修图 / 学习资源
# JOBNAV_ROLE_PROFILES_PATH=data/gold/role_profiles_v3.json
# JOBNAV_SCORE_CALIBRATION_PATH=data/gold/score_calibration_v1.json
# JOBNAV_SKILL_TREND_PANEL_V3=data/gold/skill_trend_panel_v3.json
# JOBNAV_SKILL_GRAPH_PATH_V4=data/gold/skill_prerequisite_v4.json
# JOBNAV_RESOURCES_PATH=data/gold/learning_resources_v5.json

# ---- 招聘风向标数据文件 ----
# JOBNAV_HIRING_MOMENTUM=data/gold/company_hiring_momentum.json
# JOBNAV_LAYOFF_SIGNALS=data/gold/layoff_signals.json
# JOBNAV_HN_HIRING=/data/shichaojian/JNIT/processed/hn_hiring_monthly.json

# ---- JD 数据目录（采集与融合流水线用）----
# JOBNAV_RAW_DIR=/data/shichaojian/JNIT/raw
# JOBNAV_JD_ENRICHED_DIR=/data/shichaojian/JNIT/processed/jd_unified_v3_enriched

# ---- 历史遗留：旧趋势链路（GDELT/PatchTST/技术热度）----
# 以下变量仅供 pipelines/trend/ 下的旧脚本使用，主链路已不依赖。
# 详见 README「遗留与历史模块」章节；旧脚本完整变量列表见 git 历史版本。
# JOBNAV_TREND_HORIZON_MONTHS=3
# JOBNAV_TREND_ENABLE_GDELT=false
# JOBNAV_TREND_ENABLE_GITHUB=false
# JOBNAV_TREND_ENABLE_ARXIV=false
